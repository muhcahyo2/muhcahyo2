# AI Web Profile Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit the .env file to version control!

# ============================================
# AI Provider Configuration
# ============================================
# Options: 'openai', 'anthropic', 'local'
AI_PROVIDER=openai

# Model name (provider-specific)
# OpenAI: gpt-4, gpt-4-turbo, gpt-3.5-turbo
# Anthropic: claude-3-opus-20240229, claude-3-sonnet-20240229
AI_MODEL=gpt-4

# ============================================
# API Keys (REQUIRED - Get from provider)
# ============================================
# Get your OpenAI API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your-key-here

# Get your Gemini API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-1.5-pro

# Get your Anthropic API key from: https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# ============================================
# AI Behavior Settings
# ============================================
# Temperature: Controls randomness (0.0-1.0)
# Lower = more focused, Higher = more creative
AI_TEMPERATURE=0.7

# Maximum tokens per response
# Lower = shorter responses, faster, cheaper
AI_MAX_TOKENS=500

# Top P: Nucleus sampling (0.0-1.0)
# Controls diversity of responses
AI_TOP_P=0.9

# ============================================
# Rate Limiting & Cost Control
# ============================================
# Maximum requests per user session per minute
AI_RATE_LIMIT_REQUESTS_PER_MINUTE=10

# Total tokens allowed per day (all users combined)
# Helps control API costs
AI_RATE_LIMIT_TOKENS_PER_DAY=100000

# Maximum concurrent AI requests
AI_MAX_CONCURRENT_REQUESTS=3

# ============================================
# Performance Settings
# ============================================
# Enable real-time streaming of responses
AI_STREAM_ENABLED=true

# Maximum time to wait for AI response (milliseconds)
AI_RESPONSE_TIMEOUT=10000

# Cache time-to-live in seconds (24 hours = 86400)
AI_CACHE_TTL=86400

# ============================================
# Feature Toggles
# ============================================
# Enable/disable the chat interface
AI_CHAT_ENABLED=true

# Enable/disable AI-generated profile sections
AI_PROFILE_GENERATION_ENABLED=true

# Enable/disable conversation history storage
AI_CONVERSATION_HISTORY_ENABLED=true

# ============================================
# Data Management
# ============================================
# How long to keep conversation history (in days)
AI_CONVERSATION_RETENTION_DAYS=30

# SQLite database file location
DATABASE_PATH=./.data/ai-profile.db

# ============================================
# Security Settings
# ============================================
# Maximum length for user input (characters)
AI_INPUT_MAX_LENGTH=1000

# Enable content filtering/moderation
AI_ENABLE_CONTENT_FILTER=true

# ============================================
# Optional: Custom Personality Settings
# ============================================
# These will be used in prompt templates
AI_PERSONALITY_TONE=friendly-professional
AI_PERSONALITY_TRAITS=approachable,knowledgeable,concise

# ============================================
# Development Settings (Optional)
# ============================================
# Set to 'development' for extra logging
NODE_ENV=production

# Enable debug logging for AI interactions
# AI_DEBUG=false
